# Self-contained multi-arch build of this fork (zstd fallback).
# Unlike build/docker/Dockerfile, this compiles from source in-image instead of
# consuming goreleaser artifacts, so a single docker/build-push-action step can
# publish the fork without the upstream release pipeline.
ARG BUILDPLATFORM

FROM --platform=$BUILDPLATFORM golang:1.26.5-alpine AS builder

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG TARGETOS
ARG TARGETARCH
ARG VERSION=v0.0.0-unknown

# containers_image_openpgp keeps the containers/image dependency pure Go (no
# gpgme/CGO), matching the local development build.
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build \
    -tags containers_image_openpgp \
    -trimpath \
    -ldflags "-s -w -X github.com/nicholas-fedor/watchtower/internal/meta.Version=${VERSION}" \
    -o /watchtower .

FROM scratch

# Links the published package to its source repository on GHCR. The release
# workflow overrides this with the repository actually being built.
ARG SOURCE_URL=https://github.com/NotExist/watchtower
LABEL org.opencontainers.image.source=$SOURCE_URL

# Watchtower identifies its own container by this label; every self-update
# protection (skip in the stop phase, rename-based replacement) depends on it.
# The upstream pipeline injects it via goreleaser's docker labels rather than
# the Dockerfile, so a from-source build must declare it explicitly.
LABEL com.centurylinklabs.watchtower="true"

# Last-resort persistence for the blackbox (container snapshots + log tee):
# without an explicit bind mount, records land in an anonymous volume that
# survives container removal under default settings (no --remove-volumes,
# no volume prune), recoverable via `docker volume ls -f dangling=true`.
# An explicit -v <path>:/blackbox overrides this entirely.
VOLUME /blackbox

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /watchtower /watchtower

EXPOSE 8080

HEALTHCHECK CMD ["/watchtower", "--health-check"]

ENTRYPOINT ["/watchtower"]
